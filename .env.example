# Supabase (Project Settings -> Database -> Connection string)
# DATABASE_URL: connection pooler (PgBouncer, transaction mode) -> puerto 6543
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=public"
# DIRECT_URL: conexión directa -> puerto 5432 (usada por las migraciones Prisma)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?schema=public"

# Supabase client / API (opcional, para Storage/Auth/Realtime)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_HOTEL_NAME="Hotel El Tormo"
NEXT_PUBLIC_HOTEL_WHATSAPP="34600000000"

# Email (Resend / SendGrid)
RESEND_API_KEY=""
EMAIL_FROM="reservas@hoteleltormo.com"

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Payments (Stripe)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Backoffice auth (panel /admin)
# ADMIN_PASSWORD: contraseña para entrar al panel.
# ADMIN_SESSION_SECRET: cadena aleatoria larga para firmar la cookie de sesión.
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""
